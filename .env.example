# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
ORIGIN=http://localhost:3000
KCEV_AGENT_DATA_DIR=.kcevagent

# Production authentication (generate independent values with at least 32 random bytes)
KCEV_AUTH_REQUIRED=false
KCEV_OPERATOR_TOKEN=
KCEV_SESSION_SECRET=
# Legacy v1 decryption key. Keep only while migrating existing v1 envelopes, then remove.
KCEV_SECRETS_ENCRYPTION_KEY=
# JSON keyring of key ID to 32-byte base64url key. Key IDs are public operational metadata.
KCEV_SECRETS_ENCRYPTION_KEYS={}
KCEV_SECRETS_ACTIVE_KEY_ID=
# Optional named identities. Store SHA-256 token digests, never plaintext tokens.
# KCEV_OPERATORS_JSON=[{"id":"alice@example.com","name":"Alice","role":"admin","tokenSha256":"64-hex-character-sha256","tenantId":"00000000-0000-4000-8000-000000000000","tenantName":"Organization"}]
KCEV_OPERATORS_JSON=
# Comma-separated named identity IDs allowed to create organizations. Bootstrap administrator is always included while its token is configured.
KCEV_PLATFORM_ADMIN_IDS=
KCEV_EXECUTION_CONTEXT_SECRET=
KCEV_TRUSTED_ORIGINS=
KCEV_RATE_LIMIT_PER_MINUTE=120
KCEV_MAX_INFLIGHT_REQUESTS=200
KCEV_DRAIN_DELAY_MS=5000
KCEV_SHUTDOWN_GRACE_MS=30000
KCEV_KEEP_ALIVE_TIMEOUT_MS=5000
KCEV_HEADERS_TIMEOUT_MS=10000
KCEV_REQUEST_TIMEOUT_MS=120000

# Optional bootstrap-organization OpenID Connect fallback. Tenant admins configure their own provider in Administration.
KCEV_OIDC_ISSUER=
KCEV_OIDC_CLIENT_ID=
KCEV_OIDC_CLIENT_SECRET=
KCEV_OIDC_DISPLAY_NAME=Company SSO
KCEV_OIDC_SCOPES=openid profile email
# Comma-separated HTTPS origins only when discovery endpoints differ from the issuer origin.
KCEV_OIDC_ALLOWED_ENDPOINT_ORIGINS=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KCEV_OPENAI_MODEL=gpt-5.5
KCEV_REQUIRE_OPENAI=false
KCEV_OPENAI_INPUT_USD_PER_MILLION=5
KCEV_OPENAI_OUTPUT_USD_PER_MILLION=30

# Anthropic Claude Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
KCEV_ANTHROPIC_MODEL=claude-sonnet-5
KCEV_ANTHROPIC_INPUT_USD_PER_MILLION=
KCEV_ANTHROPIC_OUTPUT_USD_PER_MILLION=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
KCEV_GEMINI_MODEL=gemini-2.5-flash
KCEV_GEMINI_INPUT_USD_PER_MILLION=
KCEV_GEMINI_OUTPUT_USD_PER_MILLION=

# xAI Grok API
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
KCEV_XAI_MODEL=grok-4.5
KCEV_XAI_INPUT_USD_PER_MILLION=
KCEV_XAI_OUTPUT_USD_PER_MILLION=

# Server-only Supabase persistence. Never expose these values to browser code.
KCEV_STORAGE_BACKEND=supabase
KCEV_MEMORY_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_TENANT_ID=00000000-0000-4000-8000-000000000000
KCEV_TENANT_DISPLAY_NAME=Primary organization

# Local Ollama execution
KCEV_OLLAMA_BASE_URL=http://127.0.0.1:11434
KCEV_OLLAMA_MODEL=ornith:9b

# Local OpenAI-compatible runtimes (LM Studio, llama.cpp server, vLLM, text-generation-webui)
KCEV_LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
KCEV_LOCAL_OPENAI_API_KEY=local-not-required
KCEV_LOCAL_OPENAI_MODEL=local-model
